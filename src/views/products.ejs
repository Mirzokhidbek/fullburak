<%- include('includes/header') %>

<main class="container-fluid px-lg-5 my-5 flex-grow-1">
  <!-- Top Title & Action Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0">Product Catalog</h2>
        <span class="badge bg-dark rounded-pill px-3 py-1 fw-bold text-warning"><%= products ? products.length : 0 %> Items</span>
      </div>
      <p class="text-muted mb-0">Add, organize, and manage dishes, beverages, and desserts in your restaurant catalog.</p>
    </div>

    <div>
      <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#addProductModal">
        <i class="fa-solid fa-plus-circle"></i> Add New Product
      </button>
    </div>
  </div>

  <!-- Products Table Card -->
  <div class="admin-table-container">
    <div class="table-responsive">
      <table class="table admin-table align-middle">
        <thead>
          <tr>
            <th scope="col" class="ps-4">#</th>
            <th scope="col">Image</th>
            <th scope="col">Product Title</th>
            <th scope="col">Collection</th>
            <th scope="col">Size / Volume</th>
            <th scope="col">Price</th>
            <th scope="col">Stock Count</th>
            <th scope="col">Views</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-center pe-4">Change Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length) { %>
            <% products.forEach((product, index) => { %>
              <tr>
                <td class="ps-4 fw-bold text-muted"><%= index + 1 %></td>
                <td>
                  <% if (product.productImages && product.productImages.length) { %>
                    <img src="/<%= product.productImages[0].replace('public/', '') %>" alt="<%= product.productName %>" class="product-img-thumb">
                  <% } else { %>
                    <div class="product-img-thumb bg-light d-flex align-items-center justify-content-center text-muted">
                      <i class="fa-solid fa-utensils"></i>
                    </div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-bold text-dark"><%= product.productName %></div>
                  <div class="small text-muted text-truncate" style="max-width: 220px;"><%= product.productDesc || 'No description provided' %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border px-2 py-1 fw-semibold"><%= product.productCollection %></span>
                </td>
                <td>
                  <span class="text-muted"><%= product.productSize || product.productVolume || '-' %></span>
                </td>
                <td>
                  <span class="fw-bold text-success fs-6">$<%= product.productPrice.toFixed(2) %></span>
                </td>
                <td>
                  <span class="fw-semibold <%= product.productLeftCount <= 5 ? 'text-danger' : 'text-dark' %>">
                    <%= product.productLeftCount %> units
                  </span>
                </td>
                <td>
                  <span class="text-muted small"><i class="fa-regular fa-eye me-1"></i><%= product.productViews || 0 %></span>
                </td>
                <td>
                  <span id="status-badge-<%= product._id %>" class="badge-status <%= product.productStatus.toLowerCase() %>">
                    <%= product.productStatus %>
                  </span>
                </td>
                <td class="text-center pe-4">
                  <select class="form-select-modern form-select-sm product-status-select" data-id="<%= product._id %>">
                    <option value="PROCESS" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                    <option value="PAUSE" <%= product.productStatus === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                    <option value="DELETE" <%= product.productStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                  </select>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                <div class="p-4">
                  <i class="fa-solid fa-bowl-rice fa-3x mb-3 text-secondary d-block"></i>
                  <h5 class="fw-bold text-dark">No Products Available Yet</h5>
                  <p class="small text-muted mb-3">Your restaurant menu is currently empty. Click the button below to add your first delicious dish.</p>
                  <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
                    <i class="fa-solid fa-plus-circle"></i> Add First Item
                  </button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Advanced Add Product Modal -->
  <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
        <div class="modal-header bg-dark text-white border-0 py-3 px-4">
          <div class="d-flex align-items-center gap-2">
            <div class="brand-icon" style="width: 32px; height: 32px; font-size: 0.9rem;">
              <i class="fa-solid fa-plus"></i>
            </div>
            <h5 class="modal-title fw-bold mb-0">Create New Restaurant Product</h5>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form action="/admin/product/create" method="POST" enctype="multipart/form-data">
          <div class="modal-body p-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted">PRODUCT NAME</label>
                <input type="text" class="form-control-modern w-100" name="productName" placeholder="e.g. Istanbul Kebab Special" required>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted">PRICE ($)</label>
                <input type="number" step="0.01" class="form-control-modern w-100" name="productPrice" placeholder="18.50" required>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-semibold small text-muted">STOCK COUNT</label>
                <input type="number" class="form-control-modern w-100" name="productLeftCount" placeholder="100" required>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted">COLLECTION TYPE</label>
                <select class="form-select-modern w-100" name="productCollection" required>
                  <option value="DISH" selected>DISH (Meals & Steaks)</option>
                  <option value="DRINK">DRINK (Beverages)</option>
                  <option value="DESERT">DESERT (Baklava, Sweets)</option>
                  <option value="OTHER">OTHER</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold small text-muted">PORTION SIZE</label>
                <select class="form-select-modern w-100" name="productSize">
                  <option value="NORMAL" selected>NORMAL</option>
                  <option value="SMALL">SMALL</option>
                  <option value="LARGE">LARGE</option>
                  <option value="SET">SET (Combo)</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold small text-muted">PRODUCT IMAGES (MAX 5 IMAGES)</label>
                <div class="image-upload-box" onclick="$('#productImagesInput').click()">
                  <i class="fa-solid fa-cloud-arrow-up text-warning fa-2x mb-2"></i>
                  <div class="fw-bold text-dark">Click to browse product photos</div>
                  <div class="small text-muted">PNG, JPG, JPEG or WEBP formats supported</div>
                </div>
                <input type="file" id="productImagesInput" name="productImages" class="d-none" multiple required>
                <div id="imagePreviewContainer" class="preview-container"></div>
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold small text-muted">PRODUCT DESCRIPTION</label>
                <textarea class="form-control-modern w-100" name="productDesc" rows="3" placeholder="Ingredients, taste profile, and preparation details..."></textarea>
              </div>
            </div>
          </div>

          <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-gold px-4">
              <i class="fa-solid fa-check me-1"></i> Publish Product
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer') %>
