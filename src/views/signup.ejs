<%- include('includes/header') %>

<div class="auth-wrapper flex-grow-1">
  <div class="auth-card" style="max-width: 540px;">
    <div class="auth-header">
      <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.3rem;">
        <i class="fa-solid fa-crown"></i>
      </div>
      <h3 class="fw-bold mb-1">Register Restaurant</h3>
      <p class="text-slate-400 small mb-0" style="color: #94a3b8;">Establish your restaurant administrative root console</p>
    </div>

    <div class="auth-body">
      <form action="/admin/signup" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label fw-semibold small text-muted">RESTAURANT NAME</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-store text-muted"></i>
              </span>
              <input type="text" class="form-control-modern form-control border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" name="memberNick" placeholder="e.g. Burak Restaurant" required>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold small text-muted">OFFICIAL PHONE</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-phone text-muted"></i>
              </span>
              <input type="text" class="form-control-modern form-control border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" name="memberPhone" placeholder="998901234567" required>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold small text-muted">ADMIN PASSWORD</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-lock text-muted"></i>
              </span>
              <input type="password" id="signupPassword" class="form-control-modern form-control border-start-0 border-end-0" name="memberPassword" placeholder="••••••••" required>
              <button class="btn btn-light border border-start-0 btn-toggle-password" data-target="#signupPassword" type="button" style="border-radius: 0 var(--radius-md) var(--radius-md) 0; border-color: var(--light-border);">
                <i class="fa-solid fa-eye text-muted"></i>
              </button>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold small text-muted">RESTAURANT COVER LOGO (OPTIONAL)</label>
            <input type="file" class="form-control-modern w-100" name="memberImage" accept="image/*">
          </div>

          <div class="col-12 mt-4">
            <button type="submit" class="btn-gold w-100 py-3 fs-6">
              <span>Create Restaurant Account</span>
              <i class="fa-solid fa-arrow-right ms-1"></i>
            </button>
          </div>
        </div>
      </form>

      <div class="text-center mt-4">
        <span class="text-muted small">Already registered?</span>
        <a href="/admin/login" class="text-warning fw-bold text-decoration-none ms-1 small">Sign in to console</a>
      </div>
    </div>
  </div>
</div>

<%- include('includes/footer') %>
