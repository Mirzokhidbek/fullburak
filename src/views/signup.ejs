<%- include('includes/header') %>

<main class="container my-5 flex-grow-1 d-flex align-items-center justify-content-center">
  <div class="col-md-7 col-lg-6">
    <div class="card border-0 shadow-lg rounded-4">
      <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
          <i class="fa-solid fa-user-plus text-warning fa-3x mb-3"></i>
          <h3 class="fw-bold text-dark">Register Restaurant</h3>
          <p class="text-muted">Fill out the details to register your restaurant admin account</p>
        </div>

        <form action="/admin/signup" method="POST">
          <div class="mb-3">
            <label for="memberNick" class="form-label fw-medium">Restaurant Nickname</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-user"></i></span>
              <input type="text" class="form-control" id="memberNick" name="memberNick" placeholder="BurakResto" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="memberPhone" class="form-label fw-medium">Phone Number</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-phone"></i></span>
              <input type="text" class="form-control" id="memberPhone" name="memberPhone" placeholder="998901234567" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="memberPassword" class="form-label fw-medium">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-lock"></i></span>
              <input type="password" class="form-control" id="memberPassword" name="memberPassword" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-warning w-100 py-2 fw-bold fs-5 shadow-sm">
            Signup <i class="fa-solid fa-user-check ms-1"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer') %>
