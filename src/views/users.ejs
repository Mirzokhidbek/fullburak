<%- include('includes/header') %>

<main class="container my-5 flex-grow-1">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">
        <i class="fa-solid fa-users text-warning me-2"></i> User Management
      </h2>
      <p class="text-muted mb-0">View and manage all registered customer accounts.</p>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th scope="col" class="ps-4">#</th>
              <th scope="col">User Nickname</th>
              <th scope="col">Phone Number</th>
              <th scope="col">Points</th>
              <th scope="col">Status</th>
              <th scope="col" class="text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length) { %>
              <% users.forEach((user, index) => { %>
                <tr>
                  <th scope="row" class="ps-4 text-muted"><%= index + 1 %></th>
                  <td class="fw-semibold text-dark">
                    <i class="fa-solid fa-user-circle text-secondary me-2"></i><%= user.memberNick %>
                  </td>
                  <td><%= user.memberPhone %></td>
                  <td><span class="badge bg-warning-subtle text-warning-emphasis px-3 py-1 fw-bold"><%= user.memberPoints %> pts</span></td>
                  <td>
                    <span class="badge <%= user.memberStatus === 'ACTIVE' ? 'bg-success' : (user.memberStatus === 'BLOCK' ? 'bg-danger' : 'bg-secondary') %> px-3 py-2">
                      <%= user.memberStatus %>
                    </span>
                  </td>
                  <td class="text-center">
                    <select class="form-select form-select-sm w-auto d-inline-block member-status-select" data-id="<%= user._id %>">
                      <option value="ACTIVE" <%= user.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                      <option value="BLOCK" <%= user.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
                      <option value="DELETE" <%= user.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">
                  <i class="fa-solid fa-users-slash fa-3x mb-3 text-secondary d-block"></i>
                  <h5>No users registered yet</h5>
                  <p class="small text-muted mb-0">Registered customer accounts will appear here automatically.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<script>
  $(document).ready(function() {
    $('.member-status-select').on('change', function() {
      const id = $(this).data('id');
      const memberStatus = $(this).val();

      axios.post('/admin/user/edit', {
        _id: id,
        memberStatus: memberStatus
      })
      .then(response => {
        alert("User status updated successfully!");
        window.location.reload();
      })
      .catch(err => {
        alert("Failed to update user status!");
        console.error(err);
      });
    });
  });
</script>

<%- include('includes/footer') %>
